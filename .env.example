# ARGUS environment configuration — EXAMPLE FILE
# Copy this to `.env` and fill in real values locally. `.env` is gitignored;
# never commit real API keys (see `.gitignore`).

# --- Core ---
ARGUS_ENV=development
ARGUS_LOG_LEVEL=INFO
# ARGUS_DATA_DIR=./data
# ARGUS_CONFIG_DIR=./configs

# --- Obsidian vault ---
ARGUS_OBSIDIAN_VAULT_PATH=
# ARGUS_OBSIDIAN_FULL_ENABLED=true
# ARGUS_OBSIDIAN_WRITE_BACK_ROOT=90_ARGUS

# --- User Knowledge Base ---
# User's document corpus: drop PDFs/TXT/Markdown/spreadsheets here and run
# `python scripts/ingest_knowledge_base.py` (or the UI "Ingest" action) to
# sync them into the EvidenceStore.
ARGUS_KNOWLEDGE_BASE_PATH=./knowledge_base
# ARGUS_BRAIN_VAULT_PATH=
# ARGUS_BRAIN_WRITE_BACK_ROOT=90_ARGUS

# --- Global feature switches ---
# ARGUS_MULTIMODEL_ENABLED=true
# ARGUS_MEMORY_ENABLED=true
# ARGUS_MULTIAGENT_ENABLED=true
# ARGUS_MULTIMODAL_ENABLED=true
#   ARGUS_MULTIMODAL_OCR_ENABLED=true
#   ARGUS_MULTIMODAL_TABLE_EXTRACTION_ENABLED=true
#   ARGUS_MULTIMODAL_WEB_INGESTION_ENABLED=true
#   ARGUS_MULTIMODAL_SPREADSHEET_ENABLED=true
#   ARGUS_MULTIMODAL_CHART_EXTRACTION_ENABLED=false

# --- LLM provider API keys (placeholders only) ---
# Provider entries live in configs/providers.yaml. Leave blank until needed.
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
# OPENCODE_ZEN_API_KEY=
