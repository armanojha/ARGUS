# ARGUS environment configuration — EXAMPLE FILE
# Copy this to `.env` and fill in real values locally. `.env` is gitignored;
# never commit real API keys (see `.gitignore`).

# --- Core (Phase 00.1) ---
ARGUS_ENV=development
ARGUS_LOG_LEVEL=INFO
# ARGUS_DATA_DIR=./data
# ARGUS_CONFIG_DIR=./configs

# --- Obsidian vault (used starting Phase 05 / 09) ---
ARGUS_OBSIDIAN_VAULT_PATH=
# ARGUS_OBSIDIAN_FULL_ENABLED=true        # Phase 09 full integration (classification, hypothesis research)
# ARGUS_OBSIDIAN_WRITE_BACK_ROOT=90_ARGUS

# --- User Knowledge Base + ARGUS Brain (persistent knowledge system) ---
# User's document corpus: drop PDFs/TXT/Markdown/spreadsheets here and run
# `python scripts/ingest_knowledge_base.py` (or the UI "Ingest" action) to
# sync them into the EvidenceStore.
ARGUS_KNOWLEDGE_BASE_PATH=E:/KNOWLEDGE BASE
# ARGUS's dedicated Obsidian vault (the "ARGUS brain"): human-readable,
# structured long-term knowledge ARGUS maintains. Empty until configured.
# ARGUS_BRAIN_VAULT_PATH=
# ARGUS_BRAIN_WRITE_BACK_ROOT=90_ARGUS

# --- Global feature switches ---
# MULTIMODEL (Phase 07) defaults to ON: a stock deployment uses the resilient
# MultiModelRouter (health + fallback + quota). Set ARGUS_MULTIMODEL_ENABLED=false
# to opt out to the single-provider LLMRouter. Requires model_policy + API keys.
# ARGUS_MULTIMODEL_ENABLED=true    # Phase 07 multi-model fabric (default; set false to opt out)
# ARGUS_MEMORY_ENABLED=true        # Phase 08 memory + self-evolution
# ARGUS_MULTIAGENT_ENABLED=true    # Phase 10 multi-agent debate
# ARGUS_MULTIMODAL_ENABLED=true    # Phase 11 multimodal ingestion (sub-feature flags below)
#   ARGUS_MULTIMODAL_OCR_ENABLED=true
#   ARGUS_MULTIMODAL_TABLE_EXTRACTION_ENABLED=true
#   ARGUS_MULTIMODAL_WEB_INGESTION_ENABLED=true
#   ARGUS_MULTIMODAL_SPREADSHEET_ENABLED=true
#   ARGUS_MULTIMODAL_CHART_EXTRACTION_ENABLED=false

# --- LLM provider API keys (placeholders only) ---
# Wired starting Phase 00.3 (one provider) / Phase 07 (full multi-provider
# fabric). Provider entries live in configs/providers.yaml; verify current
# availability before use (see vault decision D-005). Leave blank until needed.
GROQ_API_KEY=
GEMINI_API_KEY=
CEREBRAS_API_KEY=
# OpenCode Zen (D-014, Phase 07 extension): key from https://opencode.ai/auth
# OPENCODE_ZEN_API_KEY=